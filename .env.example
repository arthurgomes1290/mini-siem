# Caminho do banco dentro do container
SIEM_DB_PATH=/data/siem.db

# Fuso usado para regras de "horário habitual" (etapa 4)
SIEM_TZ=America/Sao_Paulo

# Webhook para alertas. Discord ou Slack são auto-detectados pela URL;
# qualquer outra URL cai no formato "generic" (JSON com text + alert cru).
# Ex: https://discord.com/api/webhooks/<id>/<token>
#     https://hooks.slack.com/services/<T>/<B>/<X>
SIEM_WEBHOOK_URL=
